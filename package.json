{
  "name": "@learning-platform/cli",
  "version": "0.1.0",
  "description": "Scaffold Learning Platform learner hubs from the shared React + Vite baseline.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "lp": "./dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "schemas",
    "docs",
    "examples",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "test": "npm run build && node --test --test-reporter=spec test/*.test.js",
    "check": "npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Acerosa/learning-platform-cli.git"
  },
  "homepage": "https://github.com/Acerosa/learning-platform-cli#readme",
  "bugs": {
    "url": "https://github.com/Acerosa/learning-platform-cli/issues"
  },
  "keywords": [
    "learning-platform",
    "cli",
    "scaffold",
    "github-pages"
  ],
  "devDependencies": {
    "@types/node": "^22.19.19",
    "typescript": "5.9.3"
  }
}
